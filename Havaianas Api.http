@Havaianas_Api_HostAddress = https://localhost:7254

# 1) Login: copiar el "token" de la respuesta
POST {{Havaianas_Api_HostAddress}}/Auth/login
Content-Type: application/json

{
  "usuario": "nicolas",
  "password": "cambiar"
}

###

# 2) Llamar a cualquier endpoint con el token
@token = pegar-token-aca
GET {{Havaianas_Api_HostAddress}}/Auth/yo
Authorization: Bearer {{token}}

###
